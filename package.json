{
	"name": "productreels",
	"version": "1.0.0",
	"description": "ProductReels — shoppable video reels for WooCommerce.",
	"private": true,
	"author": "bestwpexpert",
	"license": "GPL-2.0-or-later",
	"files": [
		"productreels.php",
		"uninstall.php",
		"index.php",
		"readme.txt",
		"LICENSE.txt",
		"README.md",
		"THIRD-PARTY-NOTICES.txt",
		"webpack.config.js",
		"src/",
		"admin/src/",
		"public/src/",
		"block/src/",
		"admin/index.php",
		"admin/class-productreels-admin.php",
		"admin/partials/",
		"admin/css/",
		"admin/images/",
		"admin/dist/*.js",
		"admin/dist/*.css",
		"admin/dist/*.asset.php",
		"admin/dist/*.LICENSE.txt",
		"block/index.php",
		"block/block.json",
		"block/dist/*.js",
		"block/dist/*.css",
		"block/dist/*.asset.php",
		"block/dist/*.LICENSE.txt",
		"includes/",
		"languages/",
		"public/index.php",
		"public/class-productreels-public.php",
		"public/dist/*.js",
		"public/dist/*.css",
		"public/dist/*.asset.php",
		"public/dist/*.LICENSE.txt"
	],
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js admin/src public/src src block/src",
		"lint:js:fix": "wp-scripts lint-js admin/src public/src src block/src --fix",
		"lint:php": "phpcs",
		"make-pot": "wp i18n make-pot . languages/productreels.pot --exclude=node_modules,admin/dist,public/dist,block/dist,build,build-prompts,*.map --domain=productreels --slug=productreels",
		"plugin-zip": "wp-scripts plugin-zip --root-folder=productreels",
		"zip": "wp-scripts build && wp-scripts plugin-zip --root-folder=productreels"
	},
	"devDependencies": {
		"@wordpress/scripts": "^35.0.0"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2"
	}
}
