{
	"name": "productreels",
	"version": "1.0.0",
	"description": "ProductReels — shoppable video reels for WooCommerce.",
	"private": true,
	"author": "Razibul Hasan",
	"license": "GPL-2.0-or-later",
	"files": [
		"productreels.php",
		"uninstall.php",
		"index.php",
		"readme.txt",
		"LICENSE.txt",
		"CHANGELOG.md",
		"admin/index.php",
		"admin/class-productreels-admin.php",
		"admin/partials/",
		"admin/css/",
		"admin/dist/*.js",
		"admin/dist/*.css",
		"admin/dist/*.asset.php",
		"block/index.php",
		"block/block.json",
		"block/dist/*.js",
		"block/dist/*.css",
		"block/dist/*.asset.php",
		"includes/",
		"languages/",
		"public/index.php",
		"public/class-productreels-public.php",
		"public/dist/*.js",
		"public/dist/*.css",
		"public/dist/*.asset.php"
	],
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js admin/src public/src src block/src",
		"lint:js:fix": "wp-scripts lint-js admin/src public/src src block/src --fix",
		"lint:php": "phpcs",
		"make-pot": "wp i18n make-pot . languages/productreels-shoppable-video-reels-for-woocommerce.pot --exclude=node_modules,admin/dist,public/dist,block/dist,build,build-prompts,*.map --domain=productreels-shoppable-video-reels-for-woocommerce --slug=productreels-shoppable-video-reels-for-woocommerce",
		"plugin-zip": "wp-scripts plugin-zip --root-folder=productreels-shoppable-video-reels-for-woocommerce",
		"zip": "wp-scripts build && wp-scripts plugin-zip --root-folder=productreels-shoppable-video-reels-for-woocommerce"
	},
	"devDependencies": {
		"@wordpress/scripts": "^35.0.0"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2"
	}
}
