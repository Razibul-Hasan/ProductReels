{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "productreels/reels",
	"version": "1.0.0",
	"title": "ProductReels",
	"category": "widgets",
	"description": "Place a ProductReels widget — a styled collection of shoppable video reels.",
	"keywords": [ "reels", "video", "shoppable", "woocommerce", "stories" ],
	"textdomain": "productreels",
	"attributes": {
		"widgetId": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "productreels-block",
	"editorStyle": "productreels-block",
	"example": {
		"attributes": {
			"widgetId": ""
		}
	}
}
